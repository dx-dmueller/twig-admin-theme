{% include "headitem.html.twig" with {title: "GENERAL_ADMIN_TITLE"|translate} %}
<link rel="stylesheet" href="{{ oViewConf.getResourceUrl()|raw }}article_picture_manager.css">

<script type="text/javascript">
    function editThis(sID) {
        var oTransfer = top.basefrm.edit.document.getElementById("transfer");
        oTransfer.oxid.value = sID;
        oTransfer.cl.value = top.basefrm.list.sDefClass;
        top.forceReloadingEditFrame();
        var oSearch = top.basefrm.list.document.getElementById("search");
        oSearch.oxid.value = sID;
        oSearch.actedit.value = 0;
        oSearch.submit();
    }
</script>

<form name="transfer" id="transfer" action="{{ oViewConf.getSelfLink()|raw }}" method="post">
    {{ oViewConf.getHiddenSid()|raw }}
    <input type="hidden" name="oxid" value="{{ oxid }}">
    <input type="hidden" name="cl" value="article_pictures">
    <input type="hidden" name="editlanguage" value="{{ editlanguage }}">
</form>

<div class="ap-container">
    <form
            id="myedit"
            enctype="multipart/form-data"
            action="{{ oViewConf.getSelfLink()|raw }}"
            method="post"
            data-ajax-base-url="{{ oViewConf.getAjaxLink()|raw }}&container=article_pictures"
            data-initial-images="{{ productImages|default([])|json_encode|escape('html_attr') }}"
            data-thumbnail-id="{{ thumbnailId|default('')|escape('html_attr') }}"
            data-icon-id="{{ iconId|default('')|escape('html_attr') }}"
    >
        {{ oViewConf.getHiddenSid()|raw }}
        <input type="hidden" name="cl" value="article_pictures">
        <input type="hidden" name="fnc" value="">
        <input type="hidden" name="oxid" value="{{ oxid }}">
        <input type="hidden" name="editval[article__oxid]" value="{{ oxid }}">
        <input type="hidden" name="oxparentid" value="{{ oxparentid }}">
        <input type="hidden" name="editlanguage" value="{{ editlanguage }}">

        {% if oViewConf.isAltImageServerConfigured() %}
            <div class="warning">
                {{ "ALTERNATIVE_IMAGE_SERVER_NOTE"|translate }}
                {% include "inputhelp.html.twig" with {'sHelpId': help_id("HELP_ALTERNATIVE_IMAGE_SERVER_NOTE"), 'sHelpText': help_text("HELP_ALTERNATIVE_IMAGE_SERVER_NOTE")} %}
            </div>
        {% endif %}

        <div class="ap-card">
            <div class="ap-card-header">
                <div>
                    {{ "GENERAL_ARTICLE_PICTURES"|translate }}
                    {% include "inputhelp.html.twig" with {'sHelpId': help_id("HELP_ARTICLE_PICTURES_PIC1"), 'sHelpText': help_text("HELP_ARTICLE_PICTURES_PIC1")} %}
                    {% if oxparentid %}
                        <div class="ap-variant-info">
                            <strong>{{ "GENERAL_VARIANTE"|translate }}</strong>
                            "<a href="javascript:editThis('{{ parentarticle.oxarticles__oxid.value }}');" class="edittext">
                                {{ parentarticle.oxarticles__oxartnum.value }} {{ parentarticle.oxarticles__oxtitle.value }}
                            </a>"
                        </div>
                    {% endif %}
                </div>
            </div>
            <div class="ap-card-body">
                <div class="ap-upload-container">
                    <div class="ap-cover-column">
                        <div id="ap-thumbnail-section" class="ap-cover-section">
                            <h5>{{ "GENERAL_THUMB"|translate }}</h5>
                            <div id="ap-thumbnail-placeholder" class="ap-cover-placeholder" data-type="thumbnail">
                                <svg class="ap-icon" viewBox="0 0 24 24">
                                    <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9
                                    2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0
                                    16H5V5h14v14zm-5-7l-3
                                    3.72L9 13l-3 4h12l-4-5z"/>
                                </svg>
                            </div>
                        </div>
                        <div id="ap-icon-section" class="ap-cover-section">
                            <h5>{{ "ARTICLE_PICTURES_ICON"|translate }}</h5>
                            <div id="ap-icon-placeholder" class="ap-cover-placeholder" data-type="icon">
                                <svg class="ap-icon" viewBox="0 0 24 24">
                                    <path d="M17 3H7c-1.1 0-2
                                    .9-2 2v14c0 1.1.9 2 2
                                    2h10c1.1 0 2-.9
                                    2-2V5c0-1.1-.9-2-2-2zm0
                                    16H7V5h10v14zm-2-7H9v5h6v-5z"/>
                                </svg>
                            </div>
                        </div>
                    </div>
                    <div class="ap-uploads-column">
                        <input
                                type="file"
                                id="ap-file-input"
                                name="newUploadedFiles[]"
                                multiple
                                accept="image/png, image/jpeg, image/gif, image/webp"
                                style="display:none;"
                        >
                        <div id="ap-error-messages" class="ap-error-messages">
                            <span class="ap-error-close-btn" id="ap-close-error-btn">
                                <svg class="ap-icon" viewBox="0 0 24 24">
                                    <path d="M19 6.41L17.59 5 12
                                    10.59 6.41 5 5 6.41
                                    10.59 12 5 17.59 6.41
                                    19 12 13.41 17.59 19
                                    19 17.59 13.41 12
                                    19 6.41z"/>
                                </svg>
                            </span>
                        </div>
                        <div id="ap-dropzone" class="ap-dropzone">
                            <svg class="ap-icon" viewBox="0 0 24 24">
                                <path d="M19.35 10.04A7.49 7.49 0 0012
                                4C9.11 4 6.6 5.64 5.35 8.04A5.994
                                5.994 0 000 14c0 3.31 2.69 6 6
                                6h13c2.76 0 5-2.24 5-5
                                0-2.64-2.05-4.78-4.65-4.96zM14
                                13v4h-4v-4H7l5-5 5 5h-3z"/>
                            </svg>
                            <p>{{ "ARTICLE_PICTURES_DRAG_DROP_IMAGES_HERE"|translate }}</p>
                            <button type="button" id="ap-browse-button" class="ap-browse-button">
                                {{ "ARTICLE_PICTURES_BROWSE_FILES"|translate }}
                            </button>
                        </div>
                        <div class="ap-grid-wrapper">
                            <div id="ap-grid" class="ap-grid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<div id="ap-image-modal" class="ap-image-modal">
    <span class="ap-close-modal" id="ap-close-modal-btn">
        <svg class="ap-icon" viewBox="0 0 24 24">
            <path d="M19 6.41L17.59 5
            12 10.59 6.41 5 5 6.41
            10.59 12 5 17.59 6.41
            19 12 13.41 17.59 19
            19 17.59 13.41 12
            19 6.41z"/>
        </svg>
    </span>
    <img class="ap-modal-content" id="ap-modal-image">
</div>

{{ script({ include: "js/libs/jquery.min.js", priority:1, dynamic:__oxid_include_dynamic }) }}
{{ script({ include: "js/libs/jquery-ui.min.js", priority:2, dynamic:__oxid_include_dynamic }) }}
{{ script({ include: "js/widgets/article_picture_manager.js", priority:3, dynamic:__oxid_include_dynamic }) }}
{{ script({ add:"$(function(){ $('#myedit').oxArticlePictureManager(); });", priority:10, dynamic:__oxid_include_dynamic }) }}

